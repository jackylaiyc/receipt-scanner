# ============================================================
# Receipt Scanner — Environment Variables
# Copy this to .env.local and fill in your values
# ============================================================

# --- NextAuth ---
# Your app's public URL (no trailing slash)
NEXTAUTH_URL=https://your-app.ondigitalocean.app
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (identity only) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web Application)
# Authorized redirect URIs: https://your-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Service Account (for Sheets + Drive access) ---
# Google Cloud Console → IAM & Admin → Service Accounts → Create → Download JSON key
# Share your spreadsheets and Drive folder with this service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=receipt-scanner@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON file (keep newlines as \n)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# --- Gemini API ---
# From Google AI Studio: https://aistudio.google.com/app/apikey
# NOTE: This is separate from Google Cloud Console OAuth credentials
GEMINI_API_KEY=

# --- Google Sheets ---
# Create two spreadsheets in Google Drive, share both with your service account email
# The spreadsheet ID is in the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
FAMILY_SPREADSHEET_ID=
COMPANY_SPREADSHEET_ID=

# --- Google Drive ---
# Create a folder in Google Drive for receipt images
# Share the folder with your service account email (Editor access)
# The folder ID is in the URL: drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=

# --- App Config ---
DEFAULT_CURRENCY=USD
NEXT_PUBLIC_APP_URL=https://your-app.ondigitalocean.app

# --- Access Control ---
# Comma-separated list of Google email addresses allowed to access Company data
# Typically just your own email address
COMPANY_ALLOWED_EMAILS=you@gmail.com

# ============================================================
# Hotel Booking Site — Environment Variables
# ============================================================

# --- Hotel branding (public) ---
NEXT_PUBLIC_HOTEL_NAME="Your Hotel"
NEXT_PUBLIC_HOTEL_CURRENCY=HKD
NEXT_PUBLIC_HOTEL_EMAIL=reservations@yourhotel.com

# --- Beds24 API v2 ---
# 1. Log into Beds24 → Settings → Apps & Integrations → API
# 2. Invite an API key (with read+write scopes on bookings, properties, inventory)
# 3. Redeem to get a refresh token (paste below)
# Docs: https://beds24.com/api/v2/
BEDS24_REFRESH_TOKEN=
# Single-property ID (the hotel you manage — 27 rooms share one property)
BEDS24_PROPERTY_ID=

# --- Stripe ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook endpoint secret for /api/webhooks/stripe
# Create at: https://dashboard.stripe.com/webhooks (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal ---
# https://developer.paypal.com/dashboard/applications
# Set PAYPAL_ENV=live for production, leave empty or "sandbox" for testing
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Same client id, exposed to the browser for PayPal Smart Buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ============================================================
# Setup Checklist:
# 1. Google Cloud Console (console.cloud.google.com):
#    - Enable: Google Sheets API, Google Drive API
#    - Create Service Account, download JSON key
#    - Create OAuth 2.0 Web Client (for user sign-in)
# 2. Google AI Studio (aistudio.google.com):
#    - Create API key for Gemini
# 3. Google Sheets:
#    - Create "Family Expenses" spreadsheet → copy ID
#    - Create "Company Expenses" spreadsheet → copy ID
#    - Share BOTH with service account email as Editor
# 4. Google Drive:
#    - Create "Receipt Images" folder → copy ID
#    - Share with service account email as Editor
# 5. Deploy to Digital Ocean App Platform:
#    - Set all env vars above in App Platform → Environment Variables
# ============================================================
